+
+/* Change the interface of an initialised mEMAC at runtime, after its SerDes
+ * lane has been moved to another protocol (10GBASE-R <-> SGMII, 1000BASE-X
+ * or 2500BASE-X on MAC9/MAC10). It redoes what MemacInit() derives from the
+ * interface -- IF_MODE, the TX FIFO thresholds and the internal PCS -- and
+ * leaves the rest (addresses, pause, frame length, interrupts) as it is.
+ *
+ * The speed in enetMode is the caller's: a 10G MAC keeps 10000 there at any
+ * line rate, as at init. autoneg selects in-band (clause 37 / SGMII)
+ * negotiation on the PCS; 2500BASE-X never negotiates.
+ */
+static t_Error MemacSetEnetMode(t_Handle h_Memac, e_EnetMode enetMode, bool autoneg)
+{
+    t_Memac             *p_Memac = (t_Memac *)h_Memac;
+    struct memac_regs   *p_Regs;
+    e_EnetInterface     enetInterface;
+    uint32_t            tmp;
+    bool                fixed, slow10g;
+
+    SANITY_CHECK_RETURN_ERROR(p_Memac, E_INVALID_HANDLE);
+    SANITY_CHECK_RETURN_ERROR(!p_Memac->p_MemacDriverParam, E_INVALID_STATE);
+
+    enetInterface = ENET_INTERFACE_FROM_MODE(enetMode);
+    if (enetInterface != e_ENET_IF_SGMII &&
+        enetInterface != e_ENET_IF_XGMII &&
+        enetInterface != e_ENET_IF_XFI)
+        RETURN_ERROR(MINOR, E_NOT_SUPPORTED, ("interface 0x%x", enetInterface));
+
+    p_Regs = p_Memac->p_MemMap;
+    slow10g = (p_Memac->fmMacControllerDriver.fmRevInfo.majorRev == 6 &&
+               p_Memac->fmMacControllerDriver.fmRevInfo.minorRev == 4);
+
+    p_Memac->enetMode = enetMode;
+
+    tmp = GET_UINT32(p_Regs->if_mode);
+    tmp &= ~(IF_MODE_MASK | IF_MODE_HD | IF_MODE_RGMII | IF_MODE_RGMII_AUTO);
+    if (enetInterface == e_ENET_IF_SGMII)
+    {
+        tmp |= IF_MODE_GMII;
+        WRITE_UINT32(p_Regs->if_mode, tmp);
+        WRITE_UINT32(p_Regs->tx_fifo_sections,
+                     TX_FIFO_SECTIONS_TX_AVAIL_1G |
+                     TX_FIFO_SECTIONS_TX_EMPTY_DEFAULT_1G);
+
+        /* The PCS setup reads "fixed" to decide whether to negotiate */
+        fixed = p_Memac->fixed;
+        p_Memac->fixed = !autoneg;
+        MemacInitInternalPhy(h_Memac);
+        p_Memac->fixed = fixed;
+    }
+    else
+    {
+        tmp |= IF_MODE_XGMII;
+        WRITE_UINT32(p_Regs->if_mode, tmp);
+        WRITE_UINT32(p_Regs->tx_fifo_sections,
+                     (slow10g ? TX_FIFO_SECTIONS_TX_AVAIL_SLOW_10G :
+                                TX_FIFO_SECTIONS_TX_AVAIL_10G) |
+                     TX_FIFO_SECTIONS_TX_EMPTY_DEFAULT_10G);
+    }
+
+    return E_OK;
+}
+
+/* ......................................................................... */
+
+/* Receive link of the PCS behind the MAC's own MDIO: the 1G PCS (clause 22,
+ * BMSR) in an SGMII mode, the 10GBASE-R PCS (clause 45, MMD 3 PCS status 1)
+ * otherwise. Both bits latch low, so read twice for the current state.
+ * p_Lpa, if set, gets the 1G PCS's link partner ability (0 at 10G).
+ */
+static t_Error MemacGetPcsLink(t_Handle h_Memac, bool *p_Link, uint16_t *p_Lpa)
+{
+    t_Memac     *p_Memac = (t_Memac *)h_Memac;
+    e_EnetMode  enetMode;
+    uint16_t    val = 0, lpa = 0;
+    t_Error     err;
+
+    SANITY_CHECK_RETURN_ERROR(p_Memac, E_INVALID_HANDLE);
+    SANITY_CHECK_RETURN_ERROR(!p_Memac->p_MemacDriverParam, E_INVALID_STATE);
+    SANITY_CHECK_RETURN_ERROR(p_Link, E_NULL_POINTER);
+
+    enetMode = p_Memac->enetMode;
+    if (ENET_INTERFACE_FROM_MODE(enetMode) == e_ENET_IF_SGMII)
+    {
+        /* MII access picks clause 22 or 45 by the speed in enetMode; the
+         * 1G PCS of a 10G MAC is clause 22 (see SetupSgmiiInternalPhy) */
+        p_Memac->enetMode = MAKE_ENET_MODE(ENET_INTERFACE_FROM_MODE(enetMode),
+                                           e_ENET_SPEED_1000);
+        MEMAC_MII_ReadPhyReg(p_Memac, PHY_MDIO_ADDR, 0x1, &val);
+        err = MEMAC_MII_ReadPhyReg(p_Memac, PHY_MDIO_ADDR, 0x1, &val);
+        if (!err)
+            err = MEMAC_MII_ReadPhyReg(p_Memac, PHY_MDIO_ADDR, 0x5, &lpa);
+        p_Memac->enetMode = enetMode;
+    }
+    else
+    {
+        /* Clause 45: port 0, MMD 3 (PCS), register 1 */
+        MEMAC_MII_ReadPhyReg(p_Memac, 3, 0x1, &val);
+        err = MEMAC_MII_ReadPhyReg(p_Memac, 3, 0x1, &val);
+    }
+    if (err)
+        RETURN_ERROR(MINOR, err, NO_MSG);
+
+    *p_Link = !!(val & 0x0004);
+    if (p_Lpa)
+        *p_Lpa = lpa;
+
+    return E_OK;
+}
